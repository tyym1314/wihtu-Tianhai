# Candidate first-migration artifact: replacing the existing shared vhost still
# requires a reviewed shared-host cutover. Do not install this example directly.
# The dedicated listener must already pass TLS, identity and all route checks.
server {
    listen 443 ssl http2;
    server_name oasis-mock.43.98.202.236.sslip.io;
    ssl_certificate /opt/oasis/acme/config/live/oasis-android-mock/fullchain.pem;
    ssl_certificate_key /opt/oasis/acme/config/live/oasis-android-mock/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 128k;
    # Do not recompress or recode the inner profile's explicit representations.
    gzip off;
    gunzip off;
    charset off;
    expires off;

    location / {
        # No URI suffix/rewrite: retain the original request URI and query.
        proxy_pass https://127.0.0.1:18986;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
        proxy_ssl_name oasis-mock.43.98.202.236.sslip.io;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        proxy_ssl_session_reuse on;
        proxy_read_timeout 60s;
        proxy_cache off;
        proxy_intercept_errors off;
        # Preserve dedicated ingress Cache-Control, ETag, Range and MIME.
        proxy_buffering off;
    }
}
