# Copy outside the release tree; chmod 0600; replace every placeholder.
# The matching live runtime.env is read only by the short-lived root preflight.
MOCK_SANDBOX_KIND=isolated-13-game-mock
NODE_ENV=production
OASIS_ENVIRONMENT=sandbox
OASIS_PRODUCTION_ADMISSION_ENABLED=0
OASIS_START_WALLET=1
OASIS_PUBLIC_ORIGIN=https://mock-game.example.invalid
# Fill in the listener that actually hosts the newly created mock database.
# 18883 belongs to the current live PostgreSQL service and is not provisioned by this template.
OASIS_DATABASE_URL=postgres://DEDICATED_MOCK_USER:DEDICATED_MOCK_PASSWORD@MOCK_POSTGRES_HOST:MOCK_POSTGRES_PORT/oasis_android_mock
OASIS_LOCAL_DIR=/opt/oasis/private/android-mock/state
OASIS_API_PORT=18981
OASIS_WALLET_PORT=18982
OASIS_DEMO_PORT=18985
OASIS_REFERENCE_WALLET_URL=http://127.0.0.1:18982
OASIS_WALLET_ALLOWED_ORIGINS=http://127.0.0.1:18982
OASIS_TRUST_LOOPBACK_PROXY=1
