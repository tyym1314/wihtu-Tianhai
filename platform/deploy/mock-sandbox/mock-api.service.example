[Unit]
Description=OASIS isolated Android mock game API and reference wallet
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=oasis-mock
Group=oasis-mock
WorkingDirectory=/opt/oasis/current/platform
EnvironmentFile=/opt/oasis/private/android-mock/runtime.env
# Prefix + runs this one-shot check as root, so the long-lived mock process
# never receives the live DB password or private key.
ExecStartPre=+/usr/bin/node deploy/mock-sandbox/preflight.mjs --mock-env /opt/oasis/private/android-mock/runtime.env --live-env /opt/oasis/private/runtime.env
ExecStart=/usr/bin/node --import tsx server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/oasis/private/android-mock
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
