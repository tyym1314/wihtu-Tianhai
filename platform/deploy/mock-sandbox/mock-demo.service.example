[Unit]
Description=OASIS isolated Android mock guest game host
After=oasis-android-mock-api.service
Requires=oasis-android-mock-api.service
PartOf=oasis-android-mock-api.service

[Service]
Type=simple
User=oasis-mock
Group=oasis-mock
WorkingDirectory=/opt/oasis/android-mock-current/platform
EnvironmentFile=/opt/oasis/android-mock-private/runtime.env
ExecStartPre=+/usr/bin/python3 deploy/mock-sandbox/install.py guard
ExecStartPre=+/usr/bin/node deploy/mock-sandbox/preflight.mjs --mock-env /opt/oasis/android-mock-private/runtime.env --live-env /opt/oasis/private/runtime.env
ExecStart=/usr/bin/node --import tsx deploy/demo-host.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/oasis/android-mock-private/state
CPUQuota=25%
MemoryHigh=256M
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
