# Separate production instance only. Never source into the existing sandbox.
NODE_ENV=production
OASIS_ENVIRONMENT=production
OASIS_PRODUCTION_ADMISSION_ENABLED=0
OASIS_START_WALLET=0
OASIS_PUBLIC_ORIGIN=https://YOUR_VERIFIED_PRODUCTION_HOST
OASIS_DATABASE_URL=postgres://DEDICATED_USER:SECRET@127.0.0.1:18883/DEDICATED_PRODUCTION_DATABASE
OASIS_LOCAL_DIR=/opt/oasis/private/production/state/
OASIS_API_PORT=18891
OASIS_WALLET_ALLOWED_ORIGINS=https://YOUR_VERIFIED_PARTNER_WALLET
OASIS_TRUST_LOOPBACK_PROXY=1
OASIS_ENGINE_WORKERS=2
OASIS_ENGINE_QUEUE=64
# Generate a private 32-byte master.key BEFORE the first start. Do not copy sandbox keys.
