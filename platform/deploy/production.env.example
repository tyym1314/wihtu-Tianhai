# Separate production instance only. Never source into the existing sandbox.
NODE_ENV=production
OASIS_ENVIRONMENT=production
OASIS_PRODUCTION_ADMISSION_ENABLED=0
OASIS_START_WALLET=0
OASIS_PUBLIC_ORIGIN=https://YOUR_VERIFIED_PRODUCTION_HOST
OASIS_DATABASE_URL=postgres://DEDICATED_USER:SECRET@127.0.0.1:18883/DEDICATED_PRODUCTION_DATABASE
OASIS_LOCAL_DIR=/opt/oasis/private/production/state/
OASIS_API_PORT=18891
# Leave empty for platform-owned wallets; only external Apps require allowlisted wallet origins.
OASIS_WALLET_ALLOWED_ORIGINS=
OASIS_TRUST_LOOPBACK_PROXY=1
OASIS_ENGINE_WORKERS=2
OASIS_ENGINE_QUEUE=64
# Generate a private 32-byte master.key BEFORE the first start. Do not copy sandbox keys.

# Health reports must not borrow the sandbox monitor/report/backup services.
# These names/paths are a deployment plan, not provisioned services. Monitoring
# fails closed until the production backup producer and its identity receipt exist.
OASIS_MONITOR_STATUS_FILE=/opt/oasis/private/production/monitor/status.json
OASIS_MONITOR_BACKUP_DIR=/opt/oasis/production-backups
OASIS_MONITOR_BACKUP_UNIT=oasis-production-backup.service
OASIS_MONITOR_BACKUP_TIMER=oasis-production-backup.timer
