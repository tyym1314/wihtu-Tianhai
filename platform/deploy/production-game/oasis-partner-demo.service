[Unit]
Description=OASIS demo third-party partner (own wallet + launch backend)
After=network-online.target oasis-production-db.service
[Service]
Type=simple
User=oasis-demo
Group=oasis-demo
WorkingDirectory=/opt/oasis/production-current/platform
EnvironmentFile=/opt/oasis/partner-demo/env
ExecStart=/usr/bin/node --import tsx examples/partner-demo/server.mjs
Restart=on-failure
RestartSec=3
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
