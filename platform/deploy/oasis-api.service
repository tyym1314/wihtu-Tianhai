[Unit]
Description=OASIS integrated sandbox API and reference wallet
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=oasis
Group=oasis
WorkingDirectory=/opt/oasis/current/platform
EnvironmentFile=/opt/oasis/private/runtime.env
ExecStart=/usr/bin/node --import tsx server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/oasis/private
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
